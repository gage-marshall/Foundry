# Application Environment
FOUNDRY_ENV=development  # development, production

# Security
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com
CORS_ORIGINS=

# JWT Authentication (optional - set JWT_ENABLED=true in site config.yaml to use)
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100

# Email Provider (brevo, mailgun, smtp)
MAIL_PROVIDER=brevo
MAIL_FROM_EMAIL=noreply@example.com
MAIL_FROM_NAME=Example Site

# Brevo Configuration
BREVO_API_KEY=your-brevo-api-key-here

# Mailgun Configuration
MAILGUN_API_KEY=your-mailgun-api-key-here
MAILGUN_DOMAIN=mg.example.com
MAILGUN_API_BASE=https://api.mailgun.net/v3

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-username
SMTP_PASSWORD=your-password
SMTP_USE_TLS=true

# reCAPTCHA (optional - for contact forms)
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
